{"id":"deltarune_snowgrave","lines":[{"t":2.4,"end":3.7,"chars":[0],"who":"Berdly","text":"Noelle! There you are!","de":"Noelle! There you are!","orig":"scenes/deltarune_snowgrave/lines/01.mp3"},{"t":3.8,"end":5.7,"chars":[0],"who":"Berdly","text":"Just in time! We can both go back to Queen and—","de":"Just in time! We can both go back to Queen and—","orig":"scenes/deltarune_snowgrave/lines/02.mp3"},{"t":8.153,"end":8.936,"chars":[0],"who":"Berdly","text":"Noelle?","de":"Noelle?","orig":"scenes/deltarune_snowgrave/lines/03.mp3"},{"t":9.217,"end":10.767,"chars":[1],"who":"Noelle","text":"Kris, it looks like another enemy.","de":"Kris, it looks like another enemy.","orig":"scenes/deltarune_snowgrave/lines/04.mp3"},{"t":10.959,"end":12.226,"chars":[1],"who":"Noelle","text":"Should I freeze them?","de":"Should I freeze them?","orig":"scenes/deltarune_snowgrave/lines/05.mp3"},{"t":12.433,"end":13.5,"chars":[0],"who":"Berdly","text":"N... Noelle?","de":"N... Noelle?","orig":"scenes/deltarune_snowgrave/lines/06.mp3"},{"t":13.667,"end":15.617,"chars":[0],"who":"Berdly","text":"Noelle, it's me, don't you recognize me!?","de":"Noelle, it's me, don't you recognize me!?","orig":"scenes/deltarune_snowgrave/lines/07.mp3"},{"t":20.1,"end":21.3,"chars":[1],"who":"Noelle","text":"B... Berdly!?","de":"B... Berdly!?","orig":"scenes/deltarune_snowgrave/lines/08.mp3"},{"t":21.433,"end":23.0,"chars":[0],"who":"Berdly","text":"Noelle, are you okay...?","de":"Noelle, are you okay...?","orig":"scenes/deltarune_snowgrave/lines/09.mp3"},{"t":23.1,"end":24.7,"chars":[0],"who":"Berdly","text":"What... what are you doing with Kris?","de":"What... what are you doing with Kris?","orig":"scenes/deltarune_snowgrave/lines/10.mp3"},{"t":26.867,"end":28.184,"chars":[1],"who":"Noelle","text":"I'm just, we're just...","de":"I'm just, we're just...","orig":"scenes/deltarune_snowgrave/lines/11.mp3"},{"t":28.983,"end":30.183,"chars":[1],"who":"Noelle","text":"Getting... stronger.","de":"Getting... stronger.","orig":"scenes/deltarune_snowgrave/lines/12.mp3"},{"t":30.333,"end":33.15,"chars":[0],"who":"Berdly","text":"Getting stronger... how? Kris, what are you doing!?","de":"Getting stronger... how? Kris, what are you doing!?","orig":"scenes/deltarune_snowgrave/lines/13.mp3"},{"t":35.567,"end":36.906,"chars":[0],"who":"Berdly","text":"Wh... what? Proceed... where?","de":"Wh... what? Proceed... where?","orig":"scenes/deltarune_snowgrave/lines/14.mp3"},{"t":37.0,"end":39.0,"chars":[0],"who":"Berdly","text":"Noelle, what are they talking about!?","de":"Noelle, what are they talking about!?","orig":"scenes/deltarune_snowgrave/lines/15.mp3"},{"t":40.4,"end":42.6,"chars":[0],"who":"Berdly","text":"Th-that's it, Kris! I don't know what you're doing...","de":"Th-that's it, Kris! I don't know what you're doing...","orig":"scenes/deltarune_snowgrave/lines/16.mp3"},{"t":42.7,"end":44.467,"chars":[0],"who":"Berdly","text":"But if you're hurting my friend Noelle...","de":"But if you're hurting my friend Noelle...","orig":"scenes/deltarune_snowgrave/lines/17.mp3"},{"t":45.683,"end":47.75,"chars":[0],"who":"Berdly","text":"Then I have no choice but to stop you by force!","de":"Then I have no choice but to stop you by force!","orig":"scenes/deltarune_snowgrave/lines/18.mp3"},{"t":48.217,"end":49.75,"chars":[0],"who":"Berdly","text":"Kris, ready yourself!!","de":"Kris, ready yourself!!","orig":"scenes/deltarune_snowgrave/lines/19.mp3"},{"t":49.9,"end":51.55,"chars":[1],"who":"Noelle","text":"W-wait, Berdly, stop!","de":"W-wait, Berdly, stop!","orig":"scenes/deltarune_snowgrave/lines/20.mp3"},{"t":51.6,"end":52.583,"chars":[1],"who":"Noelle","text":"Run away!","de":"Run away!","orig":"scenes/deltarune_snowgrave/lines/21.mp3"},{"t":91.833,"end":93.483,"chars":[0],"who":"Berdly","text":"N-Noelle, look! Kris is down!","de":"N-Noelle, look! Kris is down!","orig":"scenes/deltarune_snowgrave/lines/22.mp3"},{"t":93.583,"end":95.65,"chars":[0],"who":"Berdly","text":"Now's your chance to come back over here!","de":"Now's your chance to come back over here!","orig":"scenes/deltarune_snowgrave/lines/23.mp3"},{"t":96.8,"end":97.9,"chars":[0],"who":"Berdly","text":"N... Noelle?","de":"N... Noelle?","orig":"scenes/deltarune_snowgrave/lines/24.mp3"},{"t":97.95,"end":100.4,"chars":[1],"who":"Noelle","text":"(I can... still... hear... their voice...)","de":"(I can... still... hear... their voice...)","orig":"scenes/deltarune_snowgrave/lines/25.mp3"},{"t":106.614,"end":108.031,"chars":[1],"who":"Noelle","text":"S... Snowgrave?","de":"S... Snowgrave?","orig":"scenes/deltarune_snowgrave/lines/26.mp3"},{"t":108.137,"end":109.754,"chars":[1],"who":"Noelle","text":"I... I don't know that spell.","de":"I... I don't know that spell.","orig":"scenes/deltarune_snowgrave/lines/27.mp3"},{"t":111.033,"end":113.0,"chars":[1],"who":"Noelle","text":"I'm telling you, I... I...","de":"I'm telling you, I... I...","orig":"scenes/deltarune_snowgrave/lines/28.mp3"},{"t":113.067,"end":114.984,"chars":[1],"who":"Noelle","text":"I don't know what you're talking about.","de":"I don't know what you're talking about.","orig":"scenes/deltarune_snowgrave/lines/29.mp3"},{"t":115.933,"end":117.45,"chars":[1],"who":"Noelle","text":"I'm telling you, stop!","de":"I'm telling you, stop!","orig":"scenes/deltarune_snowgrave/lines/30.mp3"},{"t":117.5,"end":119.417,"chars":[1],"who":"Noelle","text":"I... I don't know what you're talking about!","de":"I... I don't know what you're talking about!","orig":"scenes/deltarune_snowgrave/lines/31.mp3"},{"t":121.117,"end":123.283,"chars":[1],"who":"Noelle","text":"Fine. You want to see what happens so bad?","de":"Fine. You want to see what happens so bad?","orig":"scenes/deltarune_snowgrave/lines/32.mp3"},{"t":123.333,"end":125.733,"chars":[1],"who":"Noelle","text":"Watch what happens when I cast a spell I don't know!","de":"Watch what happens when I cast a spell I don't know!","orig":"scenes/deltarune_snowgrave/lines/33.mp3"},{"t":153.617,"end":154.617,"chars":[1],"who":"Noelle","text":"What...","de":"What...","orig":"scenes/deltarune_snowgrave/lines/34.mp3"},{"t":154.719,"end":155.752,"chars":[1],"who":"Noelle","text":"What happened?","de":"What happened?","orig":"scenes/deltarune_snowgrave/lines/35.mp3"},{"t":155.85,"end":158.133,"chars":[1],"who":"Noelle","text":"There was so much snow, I couldn't see anything...","de":"There was so much snow, I couldn't see anything...","orig":"scenes/deltarune_snowgrave/lines/36.mp3"},{"t":158.2,"end":159.05,"chars":[1],"who":"Noelle","text":"I...","de":"I...","orig":"scenes/deltarune_snowgrave/lines/37.mp3"},{"t":163.033,"end":165.4,"chars":[1],"who":"Noelle","text":"I don't feel so good.","de":"I don't feel so good.","orig":"scenes/deltarune_snowgrave/lines/38.mp3"},{"t":165.467,"end":166.5,"chars":[1],"who":"Noelle","text":"I think","de":"I think","orig":"scenes/deltarune_snowgrave/lines/39.mp3"},{"t":166.567,"end":169.9,"chars":[1],"who":"Noelle","text":"I'm going to go home.","de":"I'm going to go home.","orig":"scenes/deltarune_snowgrave/lines/40.mp3"}]}