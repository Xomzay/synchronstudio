{"id":"kung_fu_panda_shifu_vs_tai_lung","lines":[{"t":13.626,"end":16.326,"chars":[0],"who":"Tai Lung","text":"I have come home, Master","de":"I have come home, Master","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/01.mp3"},{"t":16.393,"end":17.893,"chars":[1],"who":"Shifu","text":"This is no longer your home.","de":"This is no longer your home.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/02.mp3"},{"t":17.943,"end":19.876,"chars":[1],"who":"Shifu","text":"And I am no longer your master.","de":"And I am no longer your master.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/03.mp3"},{"t":19.959,"end":23.442,"chars":[0],"who":"Tai Lung","text":"Yes. You have a new favorite.","de":"Yes. You have a new favorite.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/04.mp3"},{"t":23.843,"end":26.671,"chars":[0],"who":"Tai Lung","text":"So where is this... Po?","de":"So where is this... Po?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/05.mp3"},{"t":26.721,"end":29.654,"chars":[0],"who":"Tai Lung","text":"[Chuckles] Did I scare him off?","de":"[Chuckles] Did I scare him off?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/06.mp3"},{"t":29.626,"end":32.026,"chars":[1],"who":"Shifu","text":"This battle is between you and me.","de":"This battle is between you and me.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/07.mp3"},{"t":33.326,"end":36.776,"chars":[0],"who":"Tai Lung","text":"So... That is how it's going to be?","de":"So... That is how it's going to be?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/08.mp3"},{"t":36.726,"end":38.559,"chars":[1],"who":"Shifu","text":"That is how it must be.","de":"That is how it must be.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/09.mp3"},{"t":42.043,"end":43.826,"chars":[0],"who":"Tai Lung","text":"YAGHHH","de":"YAGHHH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/10.mp3"},{"t":43.876,"end":45.076,"chars":[0],"who":"Tai Lung","text":"UGH","de":"UGH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/11.mp3"},{"t":45.493,"end":46.193,"chars":[0],"who":"Tai Lung","text":"NGH","de":"NGH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/12.mp3"},{"t":46.243,"end":47.126,"chars":[0],"who":"Tai Lung","text":"ARGH","de":"ARGH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/13.mp3"},{"t":47.193,"end":48.06,"chars":[1],"who":"Shifu","text":"Yah","de":"Yah","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/14.mp3"},{"t":49.293,"end":50.026,"chars":[1],"who":"Shifu","text":"ough","de":"ough","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/15.mp3"},{"t":52.643,"end":53.51,"chars":[1],"who":"Shifu","text":"ke-yah","de":"ke-yah","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/16.mp3"},{"t":53.226,"end":57.909,"chars":[0],"who":"Tai Lung","text":"I rotted in jail for twenty years because of your weakness!","de":"I rotted in jail for twenty years because of your weakness!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/17.mp3"},{"t":57.609,"end":60.009,"chars":[1],"who":"Shifu","text":"Obeying your master is not weakness!","de":"Obeying your master is not weakness!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/18.mp3"},{"t":59.793,"end":62.726,"chars":[0],"who":"Tai Lung","text":"You knew I was the Dragon Warrior!","de":"You knew I was the Dragon Warrior!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/19.mp3"},{"t":62.776,"end":65.126,"chars":[0],"who":"Tai Lung","text":"You always knew...","de":"You always knew...","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/20.mp3"},{"t":65.476,"end":68.709,"chars":[0],"who":"Tai Lung","text":"But when Oogway said otherwise","de":"But when Oogway said otherwise","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/21.mp3"},{"t":68.767,"end":70.134,"chars":[0],"who":"Tai Lung","text":"what did you do?","de":"what did you do?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/22.mp3"},{"t":71.351,"end":73.401,"chars":[0],"who":"Tai Lung","text":"What did you do?!","de":"What did you do?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/23.mp3"},{"t":76.185,"end":77.668,"chars":[0],"who":"Tai Lung","text":"NOTHING!","de":"NOTHING!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/24.mp3"},{"t":77.117,"end":80.617,"chars":[1],"who":"Shifu","text":"You were not meant to be the Dragon Warrior! That was not my fault!","de":"You were not meant to be the Dragon Warrior! That was not my fault!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/25.mp3"},{"t":80.343,"end":82.193,"chars":[0],"who":"Tai Lung","text":"NOT YOUR FAULT?!","de":"NOT YOUR FAULT?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/26.mp3"},{"t":82.243,"end":84.21,"chars":[0],"who":"Tai Lung","text":"WHO FILLED MY HEAD WITH DREAMS?!","de":"WHO FILLED MY HEAD WITH DREAMS?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/27.mp3"},{"t":84.626,"end":87.109,"chars":[0],"who":"Tai Lung","text":"WHO DROVE ME TO TRAIN UNTIL MY BONES CRACKED?!","de":"WHO DROVE ME TO TRAIN UNTIL MY BONES CRACKED?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/28.mp3"},{"t":87.159,"end":89.959,"chars":[0],"who":"Tai Lung","text":"WHO DENIED ME MY DESTINY?!","de":"WHO DENIED ME MY DESTINY?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/29.mp3"},{"t":89.943,"end":92.176,"chars":[1],"who":"Shifu","text":"he-yah, ha, yah","de":"he-yah, ha, yah","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/30.mp3"},{"t":93.493,"end":94.993,"chars":[0],"who":"Tai Lung","text":"YAGHHH","de":"YAGHHH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/31.mp3"},{"t":99.08,"end":101.23,"chars":[1],"who":"Shifu","text":"It was never my decision to make!","de":"It was never my decision to make!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/32.mp3"},{"t":106.764,"end":108.381,"chars":[0],"who":"Tai Lung","text":"It is now.","de":"It is now.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/33.mp3"},{"t":109.376,"end":110.343,"chars":[1],"who":"Shifu","text":"Yah","de":"Yah","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/34.mp3"},{"t":110.876,"end":111.576,"chars":[1],"who":"Shifu","text":"ough","de":"ough","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/35.mp3"},{"t":113.359,"end":114.359,"chars":[1],"who":"Shifu","text":"[Grunts]","de":"[Grunts]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/36.mp3"},{"t":113.743,"end":117.176,"chars":[0],"who":"Tai Lung","text":"Give... me... the scroll!","de":"Give... me... the scroll!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/37.mp3"},{"t":117.026,"end":118.676,"chars":[1],"who":"Shifu","text":"I would rather die!","de":"I would rather die!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/38.mp3"},{"t":123.109,"end":124.109,"chars":[1],"who":"Shifu","text":"[Struggle]","de":"[Struggle]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/39.mp3"},{"t":125.143,"end":126.06,"chars":[1],"who":"Shifu","text":"[Struggle]","de":"[Struggle]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/40.mp3"},{"t":130.076,"end":131.009,"chars":[1],"who":"Shifu","text":"[Fast Exhale]","de":"[Fast Exhale]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/41.mp3"},{"t":133.676,"end":134.793,"chars":[0],"who":"Tai Lung","text":"NYEAAH","de":"NYEAAH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/42.mp3"},{"t":151.879,"end":152.696,"chars":[1],"who":"Shifu","text":"yah","de":"yah","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/43.mp3"},{"t":151.959,"end":152.909,"chars":[0],"who":"Tai Lung","text":"agh","de":"agh","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/44.mp3"},{"t":153.309,"end":157.709,"chars":[0],"who":"Tai Lung","text":"yeeeeeeeeee AGHGHHHHHHHHH","de":"yeeeeeeeeee AGHGHHHHHHHHH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/45.mp3"},{"t":154.043,"end":154.96,"chars":[1],"who":"Shifu","text":"UGH","de":"UGH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/46.mp3"},{"t":159.259,"end":160.376,"chars":[0],"who":"Tai Lung","text":"heYAH","de":"heYAH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/47.mp3"},{"t":161.359,"end":162.292,"chars":[1],"who":"Shifu","text":"ough","de":"ough","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/48.mp3"},{"t":162.876,"end":163.843,"chars":[1],"who":"Shifu","text":"ugh","de":"ugh","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/49.mp3"},{"t":163.893,"end":165.51,"chars":[0],"who":"Tai Lung","text":"uhhYAH","de":"uhhYAH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/50.mp3"},{"t":168.279,"end":172.019,"chars":[0],"who":"Tai Lung","text":"All I ever did, I did to make you proud!","de":"All I ever did, I did to make you proud!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/51.mp3"},{"t":172.069,"end":174.769,"chars":[0],"who":"Tai Lung","text":"Tell me how proud you are, Shifu!","de":"Tell me how proud you are, Shifu!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/52.mp3"},{"t":175.226,"end":177.843,"chars":[1],"who":"Shifu","text":"[Struggle]","de":"[Struggle]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/53.mp3"},{"t":175.293,"end":176.493,"chars":[0],"who":"Tai Lung","text":"Tell me!","de":"Tell me!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/54.mp3"},{"t":177.333,"end":179.316,"chars":[0],"who":"Tai Lung","text":"TELL ME!!!","de":"TELL ME!!!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/55.mp3"},{"t":182.059,"end":182.837,"chars":[1],"who":"Shifu","text":"agh","de":"agh","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/56.mp3"},{"t":182.887,"end":185.087,"chars":[1],"who":"Shifu","text":"[breathing]","de":"[breathing]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/57.mp3"},{"t":189.209,"end":192.676,"chars":[1],"who":"Shifu","text":"I... have always been proud of you.","de":"I... have always been proud of you.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/58.mp3"},{"t":193.459,"end":198.692,"chars":[1],"who":"Shifu","text":"From the first moment, I've been... proud of you.","de":"From the first moment, I've been... proud of you.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/59.mp3"},{"t":199.673,"end":201.84,"chars":[1],"who":"Shifu","text":"And it was my pride...","de":"And it was my pride...","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/60.mp3"},{"t":201.943,"end":203.66,"chars":[1],"who":"Shifu","text":"that blinded me.","de":"that blinded me.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/61.mp3"},{"t":204.09,"end":207.84,"chars":[1],"who":"Shifu","text":"I loved you too much to see what you were becoming.","de":"I loved you too much to see what you were becoming.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/62.mp3"},{"t":208.8,"end":213.167,"chars":[1],"who":"Shifu","text":"What I... was turning you into...","de":"What I... was turning you into...","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/63.mp3"},{"t":213.644,"end":217.161,"chars":[1],"who":"Shifu","text":"I'm s- I'm sorry.","de":"I'm s- I'm sorry.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/64.mp3"},{"t":225.953,"end":230.086,"chars":[0],"who":"Tai Lung","text":"I don't want your apology... I want my scroll!","de":"I don't want your apology... I want my scroll!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/65.mp3"},{"t":231.793,"end":232.976,"chars":[0],"who":"Tai Lung","text":"What?","de":"What?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/66.mp3"},{"t":234.005,"end":235.772,"chars":[0],"who":"Tai Lung","text":"WHERE IS IT?!","de":"WHERE IS IT?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/67.mp3"},{"t":236.568,"end":240.918,"chars":[1],"who":"Shifu","text":"Dragon Warrior has taken scroll halfway across China by... now.","de":"Dragon Warrior has taken scroll halfway across China by... now.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/68.mp3"},{"t":241.409,"end":242.01,"chars":[1],"who":"Shifu","text":"[coughs]","de":"[coughs]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/69.mp3"},{"t":242.06,"end":245.343,"chars":[1],"who":"Shifu","text":"You will never see that scroll, Tai Lung.","de":"You will never see that scroll, Tai Lung.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/70.mp3"},{"t":245.525,"end":249.075,"chars":[1],"who":"Shifu","text":"Never! N-Never...","de":"Never! N-Never...","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/71.mp3"},{"t":249.371,"end":250.571,"chars":[2],"who":"Po","text":"Hey!","de":"Hey!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/72.mp3"},{"t":252.343,"end":260.143,"chars":[2],"who":"Po","text":"[Out of breath] Huff... huff... huff... Stairs... huff...","de":"[Out of breath] Huff... huff... huff... Stairs... huff...","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/73.mp3"},{"t":259.633,"end":261.5,"chars":[0],"who":"Tai Lung","text":"Who are you?","de":"Who are you?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/74.mp3"},{"t":261.902,"end":266.119,"chars":[2],"who":"Po","text":"Buddy... I... am the Dragon Warrior!","de":"Buddy... I... am the Dragon Warrior!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/75.mp3"},{"t":266.76,"end":268.51,"chars":[2],"who":"Po","text":"[Exhales hard] Huhhh...","de":"[Exhales hard] Huhhh...","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/76.mp3"},{"t":269.785,"end":270.454,"chars":[0],"who":"Tai Lung","text":"You?!","de":"You?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/77.mp3"},{"t":270.504,"end":272.509,"chars":[0],"who":"Tai Lung","text":"[Laughing] Him?!","de":"[Laughing] Him?!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/78.mp3"},{"t":272.559,"end":274.679,"chars":[0],"who":"Tai Lung","text":"He's a panda. You're a panda.","de":"He's a panda. You're a panda.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/79.mp3"},{"t":274.729,"end":277.076,"chars":[0],"who":"Tai Lung","text":"What are you gonna do, big guy? Sit on me?","de":"What are you gonna do, big guy? Sit on me?","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/80.mp3"},{"t":277.126,"end":278.043,"chars":[0],"who":"Tai Lung","text":"[Chuckle]","de":"[Chuckle]","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/81.mp3"},{"t":277.726,"end":279.659,"chars":[2],"who":"Po","text":"Don't tempt me. Hahaha.","de":"Don't tempt me. Hahaha.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/82.mp3"},{"t":279.709,"end":280.593,"chars":[2],"who":"Po","text":"Nah.","de":"Nah.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/83.mp3"},{"t":280.643,"end":282.775,"chars":[2],"who":"Po","text":"I'm gonna use THIS.","de":"I'm gonna use THIS.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/84.mp3"},{"t":282.825,"end":285.659,"chars":[2],"who":"Po","text":"Haha! You want it? Come and get it.","de":"Haha! You want it? Come and get it.","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/85.mp3"},{"t":285.709,"end":286.759,"chars":[2],"who":"Po","text":"OUGH","de":"OUGH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/86.mp3"},{"t":287.226,"end":288.993,"chars":[0],"who":"Tai Lung","text":"Finally... AH!","de":"Finally... AH!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/87.mp3"},{"t":291.27,"end":292.943,"chars":[2],"who":"Po","text":"OO HO OH","de":"OO HO OH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/88.mp3"},{"t":292.993,"end":295.643,"chars":[2],"who":"Po","text":"OYAH NGUUHH","de":"OYAH NGUUHH","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/89.mp3"},{"t":299.309,"end":301.859,"chars":[2],"who":"Po","text":"Oh... AAAH!","de":"Oh... AAAH!","orig":"scenes/kung_fu_panda_shifu_vs_tai_lung/lines/90.mp3"}]}