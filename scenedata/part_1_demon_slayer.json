on_slayer/lines/113.mp3"},{"t":566.006,"end":569.006,"chars":[1],"who":"Gyomei","text":"Ihre Stärke entspricht ca der der abnehmenden Monde","de":"Ihre Stärke entspricht ca der der abnehmenden Monde","orig":"scenes/part_1_demon_slayer/lines/114.mp3"},{"t":569.199,"end":572.522,"chars":[1],"who":"Gyomei","text":"Vermutlich ist das Muzans taktik um uns zu vermirben","de":"Vermutlich ist das Muzans taktik um uns zu vermirben","orig":"scenes/part_1_demon_slayer/lines/115.mp3"},{"t":578.055,"end":579.907,"chars":[6],"who":"Muichiro","text":"Was ist mit dem Meister?","de":"Was ist mit dem Meister?","orig":"scenes/part_1_demon_slayer/lines/116.mp3"},{"t":581.021,"end":583.144,"chars":[1],"who":"Gyomei","text":"Er ist heute von uns gegangen","de":"Er ist heute von uns gegangen","orig":"scenes/part_1_demon_slayer/lines/117.mp3"},{"t":584.404,"end":586.475,"chars":[1],"who":"Gyomei","text":"Mit einem würdevollen Ende","de":"Mit einem würdevollen Ende","orig":"scenes/part_1_demon_slayer/lines/118.mp3"},{"t":587.754,"end":589.283,"chars":[6],"who":"Muichiro","text":"Sei ehrlich zu mir","de":"Sei ehrlich zu mir","orig":"scenes/part_1_demon_slayer/lines/119.mp3"},{"t":589.347,"end":593.224,"chars":[6],"who":"Muichiro","text":"Mit dieser Explosion hat er Riskiert das die Dämonen ihn ausfindig machen","de":"Mit dieser Explosion hat er Riskiert das die Dämonen ihn ausfindig machen","orig":"scenes/part_1_demon_slayer/lines/120.mp3"},{"t":593.947,"end":595.347,"chars":[6],"who":"Muichiro","text":"Hat er sich geopfert?","de":"Hat er sich geopfert?","orig":"scenes/part_1_demon_slayer/lines/121.mp3"},{"t":595.927,"end":597.588,"chars":[1],"who":"Gyomei","text":"So ist es","de":"So ist es","orig":"scenes/part_1_demon_slayer/lines/122.mp3"},{"t":597.638,"end":600.728,"chars":[1],"who":"Gyomei","text":"Er hat den Rest seiner Lebenszeit für uns eingesetzt.","de":"Er hat den Rest seiner Lebenszeit für uns eingesetzt.","orig":"scenes/part_1_demon_slayer/lines/123.mp3"},{"t":601.645,"end":602.832,"chars":[6],"who":"Muichiro","text":"erschrockndes ausatmen","de":"erschrockndes ausatmen","orig":"scenes/part_1_demon_slayer/lines/124.mp3"},{"t":604.0,"end":605.329,"chars":[6],"who":"Muichiro","text":"atmen","de":"atmen","orig":"scenes/part_1_demon_slayer/lines/125.mp3"},{"t":607.742,"end":608.942,"chars":[6],"who":"Muichiro","text":"Meister...","de":"Meister...","orig":"scenes/part_1_demon_slayer/lines/126.mp3"},{"t":616.177,"end":617.616,"chars":[6],"who":"Muichiro","text":"ich erinnere mich noch...","de":"ich erinnere mich noch...","orig":"scenes/part_1_demon_slayer/lines/127.mp3"},{"t":617.694,"end":619.965,"chars":[6],"who":"Muichiro","text":"Es war damals nach dem angriff der dämonen","de":"Es war damals nach dem angriff der dämonen","orig":"scenes/part_1_demon_slayer/lines/128.mp3"},{"t":620.016,"end":622.539,"chars":[6],"who":"Muichiro","text":"Ich konnte mich nicht rühren und habe um mein leben gerungen","de":"Ich konnte mich nicht rühren und habe um mein leben gerungen","orig":"scenes/part_1_demon_slayer/lines/129.mp3"},{"t":623.125,"end":625.119,"chars":[6],"who":"Muichiro","text":"Und der meister war stets an meiner seite","de":"Und der meister war stets an meiner seite","orig":"scenes/part_1_demon_slayer/lines/130.mp3"},{"t":627.408,"end":630.093,"chars":[6],"who":"Muichiro","text":"Er hat sich um jeden einzelnen von uns gekümmert","de":"Er hat sich um jeden einzelnen von uns gekümmert","orig":"scenes/part_1_demon_slayer/lines/131.mp3"},{"t":630.143,"end":632.285,"chars":[6],"who":"Muichiro","text":"wann immer wir im sterben lagen","de":"wann immer wir im sterben lagen","orig":"scenes/part_1_demon_slayer/lines/132.mp3"},{"t":634.24,"end":636.066,"chars":[6],"who":"Muichiro","text":"Er war wie ein Vater für uns","de":"Er war wie ein Vater für uns","orig":"scenes/part_1_demon_slayer/lines/133.mp3"},{"t":637.889,"end":639.921,"chars":[1],"who":"Gyomei","text":"Ja.. Du hast recht","de":"Ja.. Du hast recht","orig":"scenes/part_1_demon_slayer/lines/134.mp3"},{"t":640.735,"end":643.316,"chars":[6],"who":"Muichiro","text":"Muzan hat mir nicht nur meinen bruder geraubt..","de":"Muzan hat mir nicht nur meinen bruder geraubt..","orig":"scenes/part_1_demon_slayer/lines/135.mp3"},{"t":643.593,"end":645.625,"chars":[6],"who":"Muichiro","text":"Er hat uns allen unseren Vater genommen","de":"Er hat uns allen unseren Vater genommen","orig":"scenes/part_1_demon_slayer/lines/136.mp3"},{"t":646.579,"end":648.386,"chars":[6],"who":"Muichiro","text":"Dreckskerl!","de":"Dreckskerl!","orig":"scenes/part_1_demon_slayer/lines/137.mp3"},{"t":648.436,"end":649.636,"chars":[6],"who":"Muichiro","text":"\"weinend\" Muzan","de":"\"weinend\" Muzan","orig":"scenes/part_1_demon_slayer/lines/138.mp3"},{"t":649.773,"end":652.205,"chars":[6],"who":"Muichiro","text":"Ich erde mich für das alles an dir rächen","de":"Ich erde mich für das alles an dir rächen","orig":"scenes/part_1_demon_slayer/lines/139.mp3"},{"t":652.378,"end":654.591,"chars":[6],"who":"Muichiro","text":"Und dir einen qualvollen tot beschären","de":"Und dir einen qualvollen tot beschären","orig":"scenes/part_1_demon_slayer/lines/140.mp3"},{"t":655.544,"end":656.789,"chars":[1],"who":"Gyomei","text":"sei unbesorgt","de":"sei unbesorgt","orig":"scenes/part_1_demon_slayer/lines/141.mp3"},{"t":661.463,"end":664.444,"chars":[1],"who":"Gyomei","text":"Diesen Wunsch.. hegen wir alle gleichermaßen \"Wütend\\","de":"Diesen Wunsch.. hegen wir alle gleichermaßen \"Wütend\\","orig":"scenes/part_1_demon_slayer/lines/142.mp3"},{"t":671.681,"end":673.3,"chars":[8],"who":"sanemi","text":"Verehrter Meister","de":"Verehrter Meister","orig":"scenes/part_1_demon_slayer/lines/143.mp3"},{"t":675.12,"end":677.275,"chars":[8],"who":"sanemi","text":"Ich konnte euch nicht beschützen","de":"Ich konnte euch nicht beschützen","orig":"scenes/part_1_demon_slayer/lines/144.mp3"},{"t":692.767,"end":696.251,"chars":[8],"who":"sanemi","text":"Ihr kommt einen nach dem anderen aus euren löchern gekrochen","de":"Ihr kommt einen nach dem anderen aus euren löchern gekrochen","orig":"scenes/part_1_demon_slayer/lines/145.mp3"},{"t":699.232,"end":703.722,"chars":[8],"who":"sanemi","text":"Ich kann es kaum noch abwarten... euch alle abzuschlachten","de":"Ich kann es kaum noch abwarten... euch alle abzuschlachten","orig":"scenes/part_1_demon_slayer/lines/146.mp3"},{"t":711.485,"end":712.685,"chars":[9],"who":"Inosuke","text":"Ahh","de":"Ahh","orig":"scenes/part_1_demon_slayer/lines/147.mp3"},{"t":713.527,"end":714.727,"chars":[9],"who":"Inosuke","text":"Hals über Kopf","de":"Hals über Kopf","orig":"scenes/part_1_demon_slayer/lines/148.mp3"},{"t":714.884,"end":716.439,"chars":[9],"who":"Inosuke","text":"Ganz genau!","de":"Ganz genau!","orig":"scenes/part_1_demon_slayer/lines/149.mp3"},{"t":717.265,"end":721.136,"chars":[9],"who":"Inosuke","text":"Wo ho ho, was für ein bescheuertes Labyrinth","de":"Wo ho ho, was für ein bescheuertes Labyrinth","orig":"scenes/part_1_demon_slayer/lines/150.mp3"},{"t":722.052,"end":723.022,"chars":[9],"who":"Inosuke","text":"tha","de":"tha","orig":"scenes/part_1_demon_slayer/lines/151.mp3"},{"t":723.072,"end":726.742,"chars":[9],"who":"Inosuke","text":"Ich habe echt keine ahnung.. wo ich hier plötzlich gelandet bin","de":"Ich habe echt keine ahnung.. wo ich hier plötzlich gelandet bin","orig":"scenes/part_1_demon_slayer/lines/152.mp3"},{"t":726.792,"end":734.689,"chars":[9],"who":"Inosuke","text":"Aber hier wimmelts ja nur so von dämonen, perfekt ich wollte sowieso gearde, ein paar neue techniken testen, hahah","de":"Aber hier wimmelts ja nur so von dämonen, perfekt ich wollte sowieso gearde, ein paar neue techniken testen, hahah","orig":"scenes/part_1_demon_slayer/lines/153.mp3"},{"t":734.941,"end":736.638,"chars":[9],"who":"Inosuke","text":"Woho","de":"Woho","orig":"scenes/part_1_demon_slayer/lines/154.mp3"},{"t":736.693,"end":739.59,"chars":[9],"who":"Inosuke","text":"hu ha urg","de":"hu ha urg","orig":"scenes/part_1_demon_slayer/lines/155.mp3"},{"t":741.294,"end":743.673,"chars":[10],"who":"Genya","text":"rennen atmen","de":"rennen atmen","orig":"scenes/part_1_demon_slayer/lines/156.mp3"},{"t":743.723,"end":744.923,"chars":[10],"who":"Genya","text":"Wo bin ich hier gelandet?","de":"Wo bin ich hier gelandet?","orig":"scenes/part_1_demon_slayer/lines/157.mp3"},{"t":745.252,"end":746.473,"chars":[10],"who":"Genya","text":"im nest der dämonen?","de":"im nest der dämonen?","orig":"scenes/part_1_demon_slayer/lines/158.mp3"},{"t":746.523,"end":747.723,"chars":[10],"who":"Genya","text":"Was ist mit den anderen?","de":"Was ist mit den anderen?","orig":"scenes/part_1_demon_slayer/lines/159.mp3"},{"t":748.331,"end":749.531,"chars":[10],"who":"Genya","text":"Sanemi","de":"Sanemi","orig":"scenes/part_1_demon_slayer/lines/160.mp3"},{"t":750.847,"end":752.95,"chars":[10],"who":"Genya","text":"Ich hoffe das du in sicherheit bist","de":"Ich hoffe das du in sicherheit bist","orig":"scenes/part_1_demon_slayer/lines/161.mp3"},{"t":758.133,"end":759.417,"chars":[11],"who":"Zenitsu","text":"Ich hab etwas gehört","de":"Ich hab etwas gehört","orig":"scenes/part_1_demon_slayer/lines/162.mp3"},{"t":759.826,"end":762.684,"chars":[11],"who":"Zenitsu","text":"Er muss hier irgendwo in der nähe sein","de":"Er muss hier irgendwo in der nähe sein","orig":"scenes/part_1_demon_slayer/lines/163.mp3"},{"t":767.745,"end":769.88,"chars":[11],"who":"Zenitsu","text":"Das wird er mir büßen!","de":"Das wird er mir büßen!","orig":"scenes/part_1_demon_slayer/lines/164.mp3"},{"t":770.992,"end":772.457,"chars":[11],"who":"Zenitsu","text":"Mistkerl!","de":"Mistkerl!","orig":"scenes/part_1_demon_slayer/lines/165.mp3"},{"t":772.534,"end":775.044,"chars":[11],"who":"Zenitsu","text":"Dafür wirst du teuer bezahlen!","de":"Dafür wirst du teuer bezahlen!","orig":"scenes/part_1_demon_slayer/lines/166.mp3"}]}