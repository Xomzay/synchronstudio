{"id":"obsession_diner_scene","lines":[{"t":0.0,"end":3.736,"chars":[0],"who":"Nikki","text":"Bear, I love you so, so, so, so, so much...","de":"Bear, I love you so, so, so, so, so much...","orig":"scenes/obsession_diner_scene/lines/01.mp3"},{"t":4.07,"end":6.526,"chars":[0],"who":"Nikki","text":"...I don't think I could live without you.","de":"...I don't think I could live without you.","orig":"scenes/obsession_diner_scene/lines/02.mp3"},{"t":10.81,"end":13.84,"chars":[1],"who":"Bear","text":"You love me more than... anyone in the world?","de":"You love me more than... anyone in the world?","orig":"scenes/obsession_diner_scene/lines/03.mp3"},{"t":17.684,"end":20.949,"chars":[0],"who":"Nikki","text":"[softly chuckling] Yes, more than anyone...","de":"[softly chuckling] Yes, more than anyone...","orig":"scenes/obsession_diner_scene/lines/04.mp3"},{"t":23.59,"end":24.583,"chars":[1],"who":"Bear","text":"...Nikki...","de":"...Nikki...","orig":"scenes/obsession_diner_scene/lines/05.mp3"},{"t":26.192,"end":27.132,"chars":[0],"who":"Nikki","text":"Yeah?","de":"Yeah?","orig":"scenes/obsession_diner_scene/lines/06.mp3"},{"t":27.927,"end":30.2,"chars":[1],"who":"Bear","text":"Does your Dad really have cancer?","de":"Does your Dad really have cancer?","orig":"scenes/obsession_diner_scene/lines/07.mp3"},{"t":44.744,"end":45.841,"chars":[0],"who":"Nikki","text":"No...","de":"No...","orig":"scenes/obsession_diner_scene/lines/08.mp3"},{"t":49.249,"end":52.41,"chars":[0],"who":"Nikki","text":"[soft chuckle] No, no, no...","de":"[soft chuckle] No, no, no...","orig":"scenes/obsession_diner_scene/lines/09.mp3"},{"t":52.352,"end":53.005,"chars":[1],"who":"Bear","text":"What?!","de":"What?!","orig":"scenes/obsession_diner_scene/lines/10.mp3"},{"t":52.952,"end":55.672,"chars":[0],"who":"Nikki","text":"No... no, no, no...","de":"No... no, no, no...","orig":"scenes/obsession_diner_scene/lines/11.mp3"},{"t":55.722,"end":59.327,"chars":[0],"who":"Nikki","text":"No, no, no, NO, DON'T DO THAT!!!","de":"No, no, no, NO, DON'T DO THAT!!!","orig":"scenes/obsession_diner_scene/lines/12.mp3"},{"t":56.763,"end":57.343,"chars":[1],"who":"Bear","text":"What??","de":"What??","orig":"scenes/obsession_diner_scene/lines/13.mp3"},{"t":57.843,"end":58.736,"chars":[1],"who":"Bear","text":"(faintly) Nikki, Nikki...!","de":"(faintly) Nikki, Nikki...!","orig":"scenes/obsession_diner_scene/lines/14.mp3"},{"t":59.559,"end":62.438,"chars":[0],"who":"Nikki","text":"I thought we were having a nice daaaate!!","de":"I thought we were having a nice daaaate!!","orig":"scenes/obsession_diner_scene/lines/15.mp3"},{"t":59.588,"end":60.69,"chars":[1],"who":"Bear","text":"(very faintly) Please, sit down!","de":"(very faintly) Please, sit down!","orig":"scenes/obsession_diner_scene/lines/16.mp3"},{"t":61.694,"end":63.11,"chars":[1],"who":"Bear","text":"We are, we are! Sit down...","de":"We are, we are! Sit down...","orig":"scenes/obsession_diner_scene/lines/17.mp3"},{"t":62.595,"end":67.297,"chars":[0],"who":"Nikki","text":"[Throwing a fit] Why does it matter, I thought we were having a nice daaaaaaate...!","de":"[Throwing a fit] Why does it matter, I thought we were having a nice daaaaaaate...!","orig":"scenes/obsession_diner_scene/lines/18.mp3"},{"t":65.452,"end":65.98,"chars":[1],"who":"Bear","text":"We are!","de":"We are!","orig":"scenes/obsession_diner_scene/lines/19.mp3"},{"t":66.652,"end":68.564,"chars":[1],"who":"Bear","text":"(gradually whispering) We are, we are... we are...!","de":"(gradually whispering) We are, we are... we are...!","orig":"scenes/obsession_diner_scene/lines/20.mp3"},{"t":69.468,"end":72.455,"chars":[1],"who":"Bear","text":"It's ok... we are!","de":"It's ok... we are!","orig":"scenes/obsession_diner_scene/lines/21.mp3"},{"t":72.505,"end":73.498,"chars":[1],"who":"Bear","text":"We are...!","de":"We are...!","orig":"scenes/obsession_diner_scene/lines/22.mp3"}]}