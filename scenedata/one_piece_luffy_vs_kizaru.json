enes/one_piece_luffy_vs_kizaru/lines/111.mp3"},{"t":596.994,"end":599.144,"chars":[0],"who":"Luffy","text":"OLD MAN APPLE!!!","de":"OLD MAN APPLE!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/112.mp3"},{"t":599.91,"end":605.26,"chars":[0],"who":"Luffy","text":"WHAT ARE YOU DOING?! STAY IN THE DOME THING! YOU'RE GONNA GET KILLED OUT HERE!","de":"WHAT ARE YOU DOING?! STAY IN THE DOME THING! YOU'RE GONNA GET KILLED OUT HERE!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/113.mp3"},{"t":607.76,"end":610.193,"chars":[1],"who":"Kizaru","text":"Did you think I'd just let you run?","de":"Did you think I'd just let you run?","orig":"scenes/one_piece_luffy_vs_kizaru/lines/114.mp3"},{"t":612.31,"end":614.46,"chars":[1],"who":"Kizaru","text":"This is over, old man.","de":"This is over, old man.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/115.mp3"},{"t":614.637,"end":617.237,"chars":[8],"who":"Atlas","text":"DO SOMETHING, STELLA! HE'S GONNA BLOW US UP!","de":"DO SOMETHING, STELLA! HE'S GONNA BLOW US UP!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/116.mp3"},{"t":617.177,"end":619.477,"chars":[2],"who":"Stella","text":"*quiet growling leading into a louder growl*","de":"*quiet growling leading into a louder growl*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/117.mp3"},{"t":624.775,"end":626.352,"chars":[12,8],"who":"Sanji, Atlas","text":"*frightened grunting*","de":"*frightened grunting*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/118.mp3"},{"t":629.727,"end":630.31,"chars":[0],"who":"Luffy","text":"*chomp*","de":"*chomp*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/119.mp3"},{"t":631.453,"end":632.02,"chars":[0],"who":"Luffy","text":"*chomp*","de":"*chomp*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/120.mp3"},{"t":632.677,"end":633.294,"chars":[0],"who":"Luffy","text":"*chomp*","de":"*chomp*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/121.mp3"},{"t":634.36,"end":646.41,"chars":[0],"who":"Luffy","text":"*gagging*","de":"*gagging*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/122.mp3"},{"t":646.727,"end":651.677,"chars":[0],"who":"Luffy","text":"*laughing*","de":"*laughing*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/123.mp3"},{"t":654.553,"end":656.02,"chars":[1],"who":"Kizaru","text":"Uh-uh-uh!","de":"Uh-uh-uh!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/124.mp3"},{"t":656.887,"end":661.254,"chars":[0],"who":"Luffy","text":"*dodging and laughing*","de":"*dodging and laughing*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/125.mp3"},{"t":662.079,"end":663.279,"chars":[0],"who":"Luffy","text":"GAAAAH!!!","de":"GAAAAH!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/126.mp3"},{"t":664.148,"end":669.248,"chars":[0],"who":"Luffy","text":"*goofy laughing*","de":"*goofy laughing*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/127.mp3"},{"t":672.917,"end":677.384,"chars":[1],"who":"Kizaru","text":"Look, I don't know why you're doing this, but I've got orders to follow.","de":"Look, I don't know why you're doing this, but I've got orders to follow.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/128.mp3"},{"t":677.077,"end":682.744,"chars":[0],"who":"Luffy","text":"*panting/struggling* I DON'T CAAAAARE!!!","de":"*panting/struggling* I DON'T CAAAAARE!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/129.mp3"},{"t":685.394,"end":686.327,"chars":[0],"who":"Luffy","text":"*grunt*","de":"*grunt*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/130.mp3"},{"t":689.044,"end":694.844,"chars":[1],"who":"Kizaru","text":"If you'll excuse me, I have a mission to wrap up and you are wasting too much of my time!","de":"If you'll excuse me, I have a mission to wrap up and you are wasting too much of my time!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/131.mp3"},{"t":696.594,"end":700.627,"chars":[0],"who":"Luffy","text":"*grunting with a laugh at the end*","de":"*grunting with a laugh at the end*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/132.mp3"},{"t":700.727,"end":702.26,"chars":[0],"who":"Luffy","text":"Tha