{"id":"one_piece_luffy_vs_kizaru","lines":[{"t":9.945,"end":14.889,"chars":[0],"who":"Luffy","text":"uuUAAAAAAAHAHAAAAAH!!!","de":"uuUAAAAAAAHAHAAAAAH!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/001.mp3"},{"t":24.086,"end":24.863,"chars":[0],"who":"Luffy","text":"*grunt*","de":"*grunt*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/002.mp3"},{"t":25.637,"end":27.337,"chars":[0],"who":"Luffy","text":"GUM-GUUUUM...!","de":"GUM-GUUUUM...!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/003.mp3"},{"t":31.278,"end":34.837,"chars":[0],"who":"Luffy","text":"BLACK MAMBAAAAAA!!!","de":"BLACK MAMBAAAAAA!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/004.mp3"},{"t":36.06,"end":39.722,"chars":[0],"who":"Luffy","text":"HUUUUAHUAAAAAAAAHHHHHH!!!","de":"HUUUUAHUAAAAAAAAHHHHHH!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/005.mp3"},{"t":39.021,"end":42.67,"chars":[1],"who":"Kizaru","text":"Ah! Not bad. I see how you managed to beat Kaido.","de":"Ah! Not bad. I see how you managed to beat Kaido.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/006.mp3"},{"t":42.778,"end":45.978,"chars":[1],"who":"Kizaru","text":"You're certainly tough enough. But I wonder.","de":"You're certainly tough enough. But I wonder.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/007.mp3"},{"t":47.701,"end":53.388,"chars":[1],"who":"Kizaru","text":"What business does a pirate like you have protecting Dr. Vegapunk? You're putting a loooot on the line for him.","de":"What business does a pirate like you have protecting Dr. Vegapunk? You're putting a loooot on the line for him.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/008.mp3"},{"t":53.342,"end":54.363,"chars":[0],"who":"Luffy","text":"*grunt*","de":"*grunt*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/009.mp3"},{"t":54.56,"end":61.209,"chars":[0],"who":"Luffy","text":"What business do YOU have trying to kill him?! Old Man Apple helped you guys a lot! Why do you wanna get rid of him?!","de":"What business do YOU have trying to kill him?! Old Man Apple helped you guys a lot! Why do you wanna get rid of him?!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/010.mp3"},{"t":67.804,"end":69.466,"chars":[1],"who":"Kizaru","text":"It's not that I want to.","de":"It's not that I want to.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/011.mp3"},{"t":73.722,"end":74.505,"chars":[0],"who":"Luffy","text":"*grunt*","de":"*grunt*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/012.mp3"},{"t":76.055,"end":83.938,"chars":[0],"who":"Luffy","text":"*panting* Oh dammit! How far up is he going?!","de":"*panting* Oh dammit! How far up is he going?!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/013.mp3"},{"t":92.939,"end":95.022,"chars":[1],"who":"Kizaru","text":"I'd rather not kill him at all.","de":"I'd rather not kill him at all.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/014.mp3"},{"t":100.089,"end":102.956,"chars":[1],"who":"Kizaru","text":"I've known Vegapunk for a long time.","de":"I've known Vegapunk for a long time.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/015.mp3"},{"t":104.655,"end":108.438,"chars":[1],"who":"Kizaru","text":"So to be frank... I don't need to hear your opinion.","de":"So to be frank... I don't need to hear your opinion.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/016.mp3"},{"t":113.422,"end":115.489,"chars":[1],"who":"Kizaru","text":"Acceleration is power.","de":"Acceleration is power.","orig":"scenes/one_piece_luffy_vs_kizaru/lines/017.mp3"},{"t":120.139,"end":121.372,"chars":[0],"who":"Luffy","text":"*grunt*","de":"*grunt*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/018.mp3"},{"t":125.572,"end":129.122,"chars":[0],"who":"Luffy","text":"HUGHUHAHUAAAAHAHHHA!!!","de":"HUGHUHAHUAAAAHAHHHA!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/019.mp3"},{"t":130.922,"end":143.855,"chars":[2],"who":"Stella","text":"*laughing* IT'S COMPLETE! *laughing* ITS NAME IS VEGAFORCE-01! ... THE DREAM OF ALL MANKIND!","de":"*laughing* IT'S COMPLETE! *laughing* ITS NAME IS VEGAFORCE-01! ... THE DREAM OF ALL MANKIND!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/020.mp3"},{"t":146.155,"end":149.488,"chars":[2],"who":"Stella","text":"IT'S A GIANT ROBOT!!!","de":"IT'S A GIANT ROBOT!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/021.mp3"},{"t":161.289,"end":165.306,"chars":[0],"who":"Luffy","text":"uUUUUUAAAAAAHHHH!!!","de":"uUUUUUAAAAAAHHHH!!!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/022.mp3"},{"t":167.678,"end":171.545,"chars":[0],"who":"Luffy","text":"HOT! [x9] OW! [x9]","de":"HOT! [x9] OW! [x9]","orig":"scenes/one_piece_luffy_vs_kizaru/lines/023.mp3"},{"t":172.156,"end":179.806,"chars":[0],"who":"Luffy","text":"*goofy laughing*","de":"*goofy laughing*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/024.mp3"},{"t":179.889,"end":182.806,"chars":[0],"who":"Luffy","text":"Okie dokie! I'm BAAAAACK!","de":"Okie dokie! I'm BAAAAACK!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/025.mp3"},{"t":185.272,"end":190.405,"chars":[0],"who":"Luffy","text":"*distant laughter*","de":"*distant laughter*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/026.mp3"},{"t":190.055,"end":191.405,"chars":[1],"who":"Kizaru","text":"Are you kidding me?","de":"Are you kidding me?","orig":"scenes/one_piece_luffy_vs_kizaru/lines/027.mp3"},{"t":191.539,"end":195.406,"chars":[0],"who":"Luffy","text":"Haheh- Boing! Boiiinggggangg!","de":"Haheh- Boing! Boiiinggggangg!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/028.mp3"},{"t":196.891,"end":200.408,"chars":[0],"who":"Luffy","text":"*huge inhale* Huhuhehi","de":"*huge inhale* Huhuhehi","orig":"scenes/one_piece_luffy_vs_kizaru/lines/029.mp3"},{"t":202.755,"end":205.222,"chars":[3],"who":"Lilith","text":"*shocked noises*","de":"*shocked noises*","orig":"scenes/one_piece_luffy_vs_kizaru/lines/030.mp3"},{"t":203.634,"end":205.967,"chars":[4],"who":"Franky","text":"Whoa! What in the hell was that?!","de":"Whoa! What in the hell was that?!","orig":"scenes/one_piece_luffy_vs_kizaru/lines/031.mp3"},{"t":218.222,"end":219.089,"ch