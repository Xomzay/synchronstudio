{"id":"reze_2","lines":[{"t":4.52,"end":8.814,"chars":[0],"who":"Reze","text":"Kono basho, kafe no masutaa ni oshiete morattan da.","de":"Kono basho, kafe no masutaa ni oshiete morattan da.","orig":"scenes/reze_2/lines/01.mp3"},{"t":9.209,"end":14.133,"chars":[0],"who":"Reze","text":"Hanabi ga ichiban miete, dare mo hito konai maruhi supotto nan datte.","de":"Hanabi ga ichiban miete, dare mo hito konai maruhi supotto nan datte.","orig":"scenes/reze_2/lines/02.mp3"},{"t":14.345,"end":16.747,"chars":[1],"who":"Denji","text":"Oooo","de":"Oooo","orig":"scenes/reze_2/lines/03.mp3"},{"t":30.701,"end":32.364,"chars":[0],"who":"Reze","text":"Nee, Denji-kun.","de":"Nee, Denji-kun.","orig":"scenes/reze_2/lines/04.mp3"},{"t":32.608,"end":34.888,"chars":[0],"who":"Reze","text":"Iroiro kangaetan dakedo sa...","de":"Iroiro kangaetan dakedo sa...","orig":"scenes/reze_2/lines/05.mp3"},{"t":34.885,"end":35.657,"chars":[1],"who":"Denji","text":"Mo..","de":"Mo..","orig":"scenes/reze_2/lines/06.mp3"},{"t":35.783,"end":38.94,"chars":[0],"who":"Reze","text":"Yappari ima no Denji-kun no joukyou, okashii yo.","de":"Yappari ima no Denji-kun no joukyou, okashii yo.","orig":"scenes/reze_2/lines/07.mp3"},{"t":39.22,"end":42.159,"chars":[0],"who":"Reze","text":"Juuroku-sai de gakkou ni mo ikasenaide...","de":"Juuroku-sai de gakkou ni mo ikasenaide...","orig":"scenes/reze_2/lines/08.mp3"},{"t":42.241,"end":44.776,"chars":[0],"who":"Reze","text":"Akuma to koroshiai saseru nante...","de":"Akuma to koroshiai saseru nante...","orig":"scenes/reze_2/lines/09.mp3"},{"t":44.871,"end":46.966,"chars":[0],"who":"Reze","text":"Kuni ga yurushite ii koto janai.","de":"Kuni ga yurushite ii koto janai.","orig":"scenes/reze_2/lines/10.mp3"},{"t":53.062,"end":56.8,"chars":[0],"who":"Reze","text":"Shigoto yamete, watashi to issho ni nigenai?","de":"Shigoto yamete, watashi to issho ni nigenai?","orig":"scenes/reze_2/lines/11.mp3"},{"t":57.142,"end":60.142,"chars":[0],"who":"Reze","text":"Watashi ga Denji-kun o shia